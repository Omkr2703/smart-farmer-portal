# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Free MongoDB database: https://www.mongodb.com/atlas (leave empty to use in-memory storage)
MONGODB_URI=

# Optional
PORT=5000
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.5-flash-lite
# CLIENT_ORIGIN=https://omkr2703.github.io
