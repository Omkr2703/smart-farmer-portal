# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

# Get a key from https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=your-key-here

# Free MongoDB database: https://www.mongodb.com/atlas (leave empty to use in-memory storage)
MONGODB_URI=

# Optional
PORT=5000
# AI_MODEL=claude-opus-5-5
# CLIENT_ORIGIN=http://localhost:5173
